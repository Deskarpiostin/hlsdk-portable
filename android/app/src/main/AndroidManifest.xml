<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:forceQueryable="true"
        android:icon="@mipmap/ic_launcher_fore"
        android:label="Xash CO-OP"
        tools:targetApi="r">

        <meta-data
            android:name="su.xash.engine.gamedir"
            android:value="xashcoop" />

        <activity
            android:name="su.xash.xashcoop.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="su.xash.engine.MOD" />
            </intent-filter>
        </activity>
	<activity
		android:name=".VCActivity"
		android:icon="@mipmap/ic_launcher_vc"
		android:label="Valve CO-OP"
		android:roundIcon="@mipmap/ic_launcher_vc"
		android:exported="true">
		<intent-filter>
			<action android:name="android.intent.action.MAIN" />

			<category android:name="android.intent.category.LAUNCHER" />
		</intent-filter>

		<intent-filter>
			<action android:name="su.xash.engine.MOD" />
		</intent-filter>
	</activity>
    </application>

    <queries>
        <package android:name="su.xash.engine" />
        <package android:name="su.xash.engine.test" />
    </queries>
</manifest>
